
kubectl --> Realiza a criação/ler/atualizar/remover os componentes do cluster

=========================================================================================================

kubectl apply --> Ele é usado para criar ou atualizar recursos a partir de arquivos YAML ou JSON
  kubectl apply -f arquivo.yaml --> Sintaxe básica para a criação de recursos
  kubectl apply --dry-run=client -f arquivo.yaml --> serve para validar e simular a criação ou atualização
                                            de um recurso Kubernetes sem realmente enviá-lo para o cluster.

=========================================================================================================

Escalabilidade automática (HPA)
Para escalabilidade automática usa-se o recurso HPA (Horizontal Pod Autoscaler):

kubectl autoscale deployment nginx \
  --cpu-percent=70 \
  --min=2 \
  --max=10

O Kubernetes aumentará ou diminuirá os Pods conforme o consumo de CPU.

=========================================================================================================

kubectl delete --> é utilizado para remover recursos do Kubernetes.
  kubectl delete <tipo> <nome> --> Sintaxe básica
  kubectl delete pod nginx --> Excluir um Pod
  kubectl delete deployment nginx --> Excluir um Deployment
  kubectl delete service nginx-service --> Excluir um Service
  kubectl delete -f deployment.yaml --> Excluir usando YAML
  kubectl delete -f manifests/ --> Excluir vários recursos - Remove todos os recursos definidos nos YAMLs da pasta.
  kubectl delete pods --all --> Excluir todos os Pods
  kubectl delete deployments --all --> Excluir todos os Deployments
  kubectl delete all --all --> Excluir todos os recursos de um Namespace
  kubectl delete namespace producao --> Excluir um Namespace
  kubectl delete configmap app-config --> Excluir um ConfigMap
  kubectl delete secret banco-secret --> Excluir um Secret
  kubectl delete pod nginx --force --grace-period=0 --> Exclusão forçada / Se um Pod ficar preso em Terminating
  kubectl delete pod nginx -n homologacao --> Excluir recursos em outro Namespace

=========================================================================================================

kubectl describe --> exibir informações detalhadas de um recurso do Kubernetes
  kubectl describe <tipo> <nome>
  kubectl describe pod nginx --> Descrever um Pod
  kubectl describe node worker01 --> Descrever um Node
  kubectl describe deployment nginx --> Descrever um Deployment
  kubectl describe service nginx --> Descrever um Service (Muito útil para verificar se o Service encontrou os Pods corretos.)

=========================================================================================================

kubectl get --> usado no Kubernetes para listar recursos do cluster
  pods --> Listar Pods --- kubectl get pods / kubectl get po
    kubectl get pods -o wide --> Mostrar IP e Node
    kubectl get pods -n producao --> Ver em namespace específico
    kubectl get pods -w --> Monitorar em tempo real
    kubectl get pods --show-labels --> Mostrar labels
    kubectl get pods --sort-by=.metadata.name --> Ordenar
    kubectl get pod nginx --> Apenas um Pod
    kubectl get pod nginx -o yaml --> Exportar em YAML
    kubectl get pod nginx -o json --> Exportar em JSON
 
  nodes --> Listar Nodes --- kubectl get nodes |ou| kubectl get no
  
  svc --> Listar Services --- kubectl get svc |ou| kubectl get services
  
  deployments --> Listar Deployments --- kubectl get deployments |ou| kubectl get deploy
  
  namespaces --> Listar Namespaces --- kubectl get namespaces
  
  all --> Ver tudo do namespace (Pods, Services, Deployments, ReplicaSets) --- kubectl get all

==========================================================================================================

kubectl logs --> visualizar os logs gerados pelos containers de um Pod no Kubernetes.
  kubectl logs <pod>
  kubectl logs nginx --> Visualizar os logs do pod nginx
  kubectl logs -f nginx --> Logs em tempo real (follow) - semelhante ao tail -f do Linux
  kubectl logs nginx --tail=50 --> Últimas linhas do log
  kubectl logs nginx -c sidecar --> Visualizar os logs de um container em especifico
  kubectl logs nginx --previous --> Ver logs anteriores - muito útil quando um container reinicia constantemente (CrashLoopBackOff)
  kubectl logs nginx --timestamps --> Exibir timestamps
  kubectl logs deployment/nginx --> Logs de um Deployment
  kubectl logs nginx --all-containers=true --> Logs de todos os containers do Pod, muito útil para Pods com sidecars.

==========================================================================================================

kubectl run --> Criar e executar um Pod no Kubernetes de forma rápida
  kubectl run <nome-do-pod> --image=<imagem> --> Sintaxe básica para a criação de um pod --- kubectl run nginx-pod --image=nginx:latest
  
  kubectl run teste --image=busybox -it -- sh --> Executar um container interativo
    -i → mantém STDIN aberto | -t → cria terminal interativo | -- sh → executa o shell dentro do container
  
  kubectl run dns-test --image=busybox -it --rm -- nslookup kubernetes.default --> Testar conectividade
    --rm → remove o Pod ao finalizar | nslookup kubernetes.default → testa a resolução DNS do cluster

  kubectl run ubuntu --image=ubuntu -- sleep 3600 --> Cria um Pod Ubuntu que ficará ativo por 1 hora.

  kubectl run debug --image=nicolaka/netshoot -it -- bash --> Criar Pod temporário para troubleshooting
    A imagem contém ferramentas como: ping | curl | dig | tcpdump | netstat | traceroute

=========================================================================================================

kubectl scale --> Utilizado para aumentar ou diminuir a quantidade de réplicas de uma aplicação no Kubernetes, sem precisar alterar o arquivo YAML
                  O kubectl scale faz escalabilidade manual.
  kubectl scale <recurso> <nome> --replicas=<quantidade> --> Padrão 
  kubectl scale deployment nginx --replicas=5 --> Para aumentar para 5 Pods
  kubectl scale deployment nginx --replicas=2 --> Reduzir réplicas de 5 para 2
  kubectl scale deployment nginx --replicas=0 --> Parar uma aplicação sem removê-la
    Todos os Pods serão encerrados, mas o Deployment continuará existindo.
    kubectl scale deployment nginx --replicas=3 --> Para voltar
  kubectl scale statefulset mysql --replicas=3 --> Escalar StatefulSet / Muito comum em bancos de dados distribuídos.
  kubectl scale replicaset nginx-rs --replicas=4 --> Escalar ReplicaSet
  kubectl scale deployment app1 app2 app3 --replicas=3 --> Escalar vários recursos

